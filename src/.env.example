# Các biến môi trường mẫu cho gói Local.
# Sao chép file này thành .env rồi điền giá trị thật của bạn. KHÔNG commit file .env.
# Toàn bộ giá trị dưới đây là giá trị giả, không dùng thật.

# Token GHN lấy tại https://khachhang.ghn.vn (giá trị giả)
GHN_TOKEN=token-gia-khong-dung-that

# ShopId GHN của shop bạn (giá trị giả)
GHN_SHOP_ID=123456

# Môi trường GHN: production hoặc staging (giá trị giả)
GHN_ENV=staging

# Mức log: info (mặc định), warn, error. Giá trị khác được coi như info.
LOG_LEVEL=info
